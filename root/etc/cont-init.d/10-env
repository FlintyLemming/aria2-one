#!/usr/bin/with-contenv bash
PUID=${PUID:-1000}
PGID=${PGID:-1000}

if ! id -u abc > /dev/null 2>&1; then
  groupadd -g "$PGID" abc
  useradd -u "$PUID" -g "$PGID" -d /config -s /bin/bash abc
else
  groupmod -g "$PGID" abc
  usermod -u "$PUID" -g "$PGID" abc
fi

mkdir -p /config /downloads /run/nginx
chown -R abc:abc /config /downloads
